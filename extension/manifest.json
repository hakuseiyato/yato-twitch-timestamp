{
  "manifest_version": 3,
  "name": "Yato Twitch Timestamp",
  "version": "0.1.0",
  "key": "",
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://api.twitch.tv/*",
    "https://id.twitch.tv/*",
    "https://www.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["lib.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "stamp": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "タイムスタンプを押す"
    }
  }
}
