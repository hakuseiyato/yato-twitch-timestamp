{
  "manifest_version": 3,
  "name": "Peakaboo",
  "version": "0.6.0",
  "key": "",
  "permissions": [
    "identity",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.twitch.tv/*",
    "https://id.twitch.tv/*",
    "https://www.twitch.tv/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/peakaboo-16.png",
      "32": "icons/peakaboo-32.png",
      "48": "icons/peakaboo-48.png",
      "128": "icons/peakaboo-128.png"
    }
  },
  "commands": {
    "stamp": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "タイムスタンプを押す"
    }
  },
  "description": "Twitch 配信のタイムスタンプを押し、切り抜きの当たりをチームで共有する",
  "icons": {
    "16": "icons/peakaboo-16.png",
    "32": "icons/peakaboo-32.png",
    "48": "icons/peakaboo-48.png",
    "128": "icons/peakaboo-128.png"
  }
}
